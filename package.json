{
  "name": "mobile-api-ai-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:api": "node scripts/api/run.mjs",
    "test:api:smoke": "node scripts/api/run.mjs --grep @smoke",
    "report:api": "node scripts/quality/report.mjs api",
    "app:download": "node scripts/mobile/download-android.mjs",
    "test:api:crud": "node scripts/api/run.mjs --grep @crud",
    "android:local:create": "powershell.exe -NoProfile -File scripts/android-local/create.ps1",
    "android:local:start": "powershell.exe -NoProfile -File scripts/android-local/start.ps1",
    "appium:setup": "node scripts/mobile/appium.mjs setup",
    "appium:doctor": "node scripts/mobile/appium.mjs doctor",
    "appium:start": "node scripts/mobile/appium.mjs start",
    "test:mobile": "node scripts/mobile/run.mjs",
    "test:mobile:smoke": "node scripts/mobile/run.mjs --grep @smoke",
    "test:mobile:ci": "node scripts/mobile/ci.mjs",
    "report:mobile": "node scripts/mobile/report.mjs",
    "test:api:regression": "node scripts/api/run.mjs --grep @regression",
    "test:mobile:regression": "node scripts/mobile/run.mjs --grep @regression",
    "test:mobile:negative": "node scripts/mobile/run.mjs --grep @negative",
    "test:mobile:native": "node scripts/mobile/run.mjs --grep @native",
    "test:all": "node scripts/quality/ci.mjs",
    "test:all:smoke": "node scripts/quality/ci.mjs smoke",
    "test:all:regression": "node scripts/quality/ci.mjs regression",
    "test:all:list": "node scripts/quality/run.mjs --list",
    "report:all": "node scripts/quality/report.mjs combined",
    "test:api:negative": "node scripts/api/run.mjs --grep @negative",
    "test:mobile:catalog": "node scripts/mobile/run.mjs --grep @catalog",
    "test:mobile:random": "node scripts/mobile/run.mjs --grep @random",
    "test:all:catalog": "node scripts/quality/ci.mjs catalog",
    "test:all:random": "node scripts/quality/ci.mjs exploratory",
    "perf:android": "node scripts/mobile/performance.mjs",
    "report:performance": "node scripts/mobile/performance-report-server.mjs",
    "skill:prompt": "node scripts/mobile/skill-prompt.mjs",
    "test:mobile:selected": "node scripts/mobile/selected-suite.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.18.0",
    "@types/pngjs": "6.0.5",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "6.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "webdriverio": "9.20.0"
  }
}
